.root
  position relative
  height 100%

.scroll
  height 100%

.scrollInner
  padding 0 var(--indent-l) var(--indent-l)

.chevron
  position absolute
  left 50%
  bottom var(--p-6)
  z-index 2
  transform translateX(-50%)
  opacity .5
  pointer-events none
  transition .3s opacity ease-in-out
  color var(--accent-color)

  &.hidden
    opacity 0

  svg
    display block
    width 28px
    height 28px
    animation jump 1.2s ease-in-out infinite

@keyframes jump
  0%, 100%
    transform translateY(0)
  50%
    transform translateY(8px)

@media (prefers-reduced-motion: reduce)
  .chevron svg
    animation none

.version
  font-size 80%
  opacity .7
  margin var(--indent-l) auto 0
  text-align center
  padding 20px
