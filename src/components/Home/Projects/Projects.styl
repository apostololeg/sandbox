.projects
  padding 20px
  display grid
  grid-template-columns repeat(auto-fill, minmax(280px, 1fr))
  gap 1.5rem

.card
  position relative
  display block
  padding 1.5rem
  min-height 150px
  border 1px solid rgba(255, 255, 255, 0.1)
  border-radius var(--p-4)
  background rgba(255, 255, 255, 0.02)
  transition all 0.2s ease
  text-decoration none
  color inherit

  &:hover .outline
  &:focus-within .outline
    opacity 1

  h3
    padding-top 0

  & > svg
    display none

.outline
  z-index 3

.title
  display flex
  align-items center
  gap var(--p-3)

.icon
  display block
  width 32px
  height 32px
  transition transform 0.2s ease

  svg
    display block
    width 100%
    height 100%

  &:hover
    border-color rgba(255, 255, 255, 0.2)
    transform translateY(-2px)

.description
  display inline-block
  margin 0
  opacity 0.8
  line-height 1.4
  word-wrap break-word
  white-space normal

