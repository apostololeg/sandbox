.root
  position relative
  max-width 44rem
  margin 10rem auto
  padding 4rem 3.5rem
  text-align center
  font-size 1.5rem
  line-height 1.75
  border-radius var(--p-8)

  &::before
    content ''
    position absolute
    top -60%
    left 0
    width 100%
    height 200%
    background radial-gradient(
      circle at 50% 50%,
      var(--active-color-alpha-100) 0%,
      transparent 50%
    )
    animation breathing 5s infinite ease-in-out

  a
    line-height 1em

  button
    vertical-align middle
    margin 0 0.15em
    transition all 0.5s ease-in-out

@keyframes breathing {
  0% {
    transform scale(.8)
  }
  50% {
    transform scale(1.2)
  }
  100% {
    transform scale(.8)
  }
}

.thinkingOutlineContainer
  border-radius var(--p-8)
  width fit-content
  position relative
  padding 0 2px var(--p-1) 2px
  margin 0 auto
  transition all 0.5s ease-in-out

  &:hover
    transform scale(1.05)

    button
      box-shadow 0 0 30px 0 var(--active-color-alpha-500)

.thinkingOutline
  display block
  position absolute
  height 100%
  width 100%
