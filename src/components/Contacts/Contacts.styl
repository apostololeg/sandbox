@import '~theme'

.root
  position relative
  height 100%

.scroll
  height 100%

.scrollInner
  padding-top $headerHeight
  padding-left var(--indent-l)
  padding-right var(--indent-l)
  padding-bottom var(--indent-l)

.list
  padding 20px
  margin 0
  list-style none
  line-height 1.6

.item
  margin 0 0 1rem
  opacity .85
