@import '~theme';

.root
  display flex
  flex-direction column
  flex 1
  height 100%
  min-height 0
  overflow hidden

.scroll
  flex 1
  min-height 0

.scrollInner
  padding-left var(--p-6)
  padding-right var(--p-6)
  padding-top $headerHeight

.content
  padding-bottom var(--p-1)

  h1
    display none

  h2
  h3
    margin 1em 0 .4em

  // FormattedText keeps the blank line after a heading as <br>s
  h2 + br, h3 + br, h2 + br + br, h3 + br + br
    display none

  p
    line-height 1.5

.figure
  margin 1.5em 0

  img
    display block
    width 100%
    max-width 960px
    border-radius 12px
    box-shadow 0 0 0 1px rgba(255, 255, 255, .08)

  figcaption
    margin-top .6em
    font-size .85em
    opacity .6

.footer
  display flex
  align-items center
  padding var(--p-2)

.date
  opacity .5
  padding-left 1em

.langs
  display flex
  flex-wrap wrap
  gap .25em
  margin-left auto

.lang
  padding .2em .45em
  border none
  border-radius 6px
  background none
  color inherit
  font inherit
  font-size .8em
  opacity .5
  cursor pointer

  &:hover
    opacity .8

.langActive
  opacity 1
  background rgba(255, 255, 255, .1)
