@import '~theme';

.root
  display flex
  flex-direction column
  flex 1
  height 100%
  min-height 0
  overflow hidden

.scroll
  flex 1
  min-height 0

.scrollInner
  padding-left var(--p-6)
  padding-right var(--p-6)
  padding-top $headerHeight

.content
  padding-bottom var(--p-1)

  h1
    display none

  h2
  h3
    margin 1em 0 .4em

  p
    line-height 1.5

.footer
  display flex
  align-items center
  padding var(--p-2)

.date
  opacity .5
  padding-left 1em
