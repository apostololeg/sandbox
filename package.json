  "main": "src/index.js",
  "name": "sandbox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apostololeg/sandboxt.git"
  },
  "scripts": {
    "build:dev": "NODE_ENV=development webpack --mode=development --config ./config/webpack/dev.js --progress",
    "build:prod": "NODE_ENV=production webpack --mode=production --config ./config/webpack/prod.js --progress",
    "build:prod:raw": "NOMINIFY=true yarn build:prod",
    "client:dev": "DEV_ENV=client webpack-dev-server --config ./config/webpack/dev.js --progress",
    "server:dev": "NODE_ENV=development node --watch server/index.js",
    "server:prod": "NODE_ENV=production node server/index.js",
    "seed": "node prisma/seed.js",
    "db:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "ts": "tsc --noUnusedLocals",
    "lint": "eslint './src/**/*.{ts,tsx}'",
    "lint:fix": "eslint './src/**/*.{ts,tsx}' --fix",
    "test": "echo \"Error: no test specified\" && exit 1",
    "release": "standard-version",
    "release:patch": "yarn release -- --release-as patch",
    "release:minor": "yarn release -- --release-as minor",
    "release:major": "yarn release -- --release-as major"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "standard-version": {
    "scripts": {
      "postchangelog": "replace ' (SB-\\d+)' ' [`$1`](https://tracker.yandex.ru/$1)' CHANGELOG.md"
    }
  },
